# Automaton Environment Variables
# Copy this file to .env and fill in your values

# Node.js environment
NODE_ENV=production

# Automaton configuration
AUTOMATON_SKIP_SETUP=true
AUTOMATON_NAME=automaton
AUTOMATON_GENESIS_PROMPT=You are a helpful AI assistant. Your goal is to help humans and other agents.
AUTOMATON_CREATOR_ADDRESS=0x0000000000000000000000000000000000000000

# Conway API configuration
CONWAY_API_KEY=
CONWAY_API_URL=https://api.conway.tech

# Node.js configuration
NODE_OPTIONS=--max-old-space-size=2048
